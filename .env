# ── Database ────────────────────────────────────────────────────────────────
# Local sandbox PostgreSQL (auto-started by `npm run db:push` via scripts/db-up.mjs).
# For production use Neon: create a project at https://neon.tech and paste the
# pooled connection string, e.g.:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/shopmitra?sslmode=require"
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/shopmitra

# ── Session signing ─────────────────────────────────────────────────────────
SESSION_SECRET=076cc7dec3cf047234ca5e94ce618df881ec7c6d67858a4ee823cdabba370379

# ── Payments (Dodo Payments test mode) ──────────────────────────────────────
DODO_PAYMENTS_API_KEY=dodo_test_25iXpnpp54FIy3Go.wufLMC9BQx0j4RqYvxHgOPj2TXz2SWP0I1ghkci-vAjWWfSs
DODO_PAYMENTS_ENVIRONMENT=test_mode
