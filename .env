# ── Transactional email (Resend) ────────────────────────────────────────────
# Order placed / confirmed / shipped / delivered / cancelled emails.
# Get a free API key: https://resend.com/api-keys
# Without a key the app still works — emails are logged to the server console
# and recorded in the EmailLog table (dev mode).
RESEND_API_KEY=
# Sender identity. `onboarding@resend.dev` works out of the box (it can only
# deliver to your own Resend account address); verify a domain on Resend to
# email any customer address.
EMAIL_FROM=ShopMitra <onboarding@resend.dev>

# ── Public app URL (used in email links) ────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://shopmitra.in
