{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "ecomm_extracted": {
      "root": "upload/ecomm_extracted",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/ecomm_extracted/(.*)",
      "destination": {
        "service": "ecomm_extracted"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}