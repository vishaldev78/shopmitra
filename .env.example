# ─────────────────────────────────────────────────────────────────────────────
# ShopMitra — environment template
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# 1. Create a free project at https://neon.tech
# 2. Open your project → Dashboard → "Connection Details"
# 3. Choose "Pooled connection" and copy the string, then set it here:
#
# DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/shopmitra?sslmode=require"
#
# Tip: run `npm run db:push` then `npm run db:seed` to create the schema and
# the demo catalog in your Neon database.
DATABASE_URL=

# ── Session signing (required) ──────────────────────────────────────────────
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Payments — Dodo Payments (optional) ─────────────────────────────────────
# Without keys the store runs in built-in sandbox payment mode.
# https://docs.dodopayments.com/
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Webhook signing secret from the Dodo dashboard (Developers → Webhooks).
DODO_PAYMENTS_WEBHOOK_KEY=

# ── Transactional email — Resend (optional) ─────────────────────────────────
# Sends order placed / confirmed / shipped / delivered / cancelled emails.
# Free key: https://resend.com/api-keys
# Without a key, emails are logged to the console + EmailLog table (dev mode).
RESEND_API_KEY=
EMAIL_FROM=ShopMitra <onboarding@resend.dev>

# ── Public app URL (optional — used for links inside emails) ────────────────
# NEXT_PUBLIC_APP_URL=https://your-domain.com
